# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# npm is the package manager of record; a yarn.lock here would drift silently
yarn.lock

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Terraform
infrastructure/.terraform/
infrastructure/.terraform.lock.hcl
# Covers terraform.tfstate, terraform.tfstate.backup and terraform.tfstate.<epoch>.backup
infrastructure/terraform.tfstate*
infrastructure/*.tfvars
infrastructure/tfplan

# brainstorming visual companion
.superpowers/
